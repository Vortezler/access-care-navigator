# --- Primary: AWS Bedrock ---------------------------------------------
# Enable the Claude model in Bedrock console -> Model access, for this region.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional override. Some regions need an inference-profile ID instead,
# e.g. us.anthropic.claude-opus-5-5
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# --- Fallback: direct Anthropic API (optional) -------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# If neither provider is configured, the app uses built-in templates,
# so the demo still works end to end with no keys at all.

# --- Optional: one-click Google Calendar ------------------------------
# OAuth 2.0 Client ID (type "Web application") with http://localhost:3000
# as an Authorized JavaScript origin. Without it, "Add to Google Calendar"
# opens Google's pre-filled event page instead — no setup needed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
